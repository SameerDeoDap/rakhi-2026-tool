# Supabase shared-database connection (see README → "Go online with shared data").
# Copy this file to ".env" and paste your project values. ".env" is git-ignored.
# Without these variables the app runs in Local mode (browser storage only).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
